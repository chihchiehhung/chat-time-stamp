{
  "manifest_version": 3,
  "name": "Chat Time Stamp",
  "version": "1.0.0",
  "description": "Appends your local time to every message you send on supported AI chat sites.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/sites/claude.js", "content/core.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Chat Time Stamp",
    "default_popup": "popup.html"
  }
}
