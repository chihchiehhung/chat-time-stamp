{
  "manifest_version": 3,
  "name": "Chat Time Stamp",
  "version": "1.0.0",
  "description": "Appends your local time to every message you send on supported AI chat sites.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/sites/claude.js", "content/core.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/sites/gemini.js", "content/core.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Chat Time Stamp",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  }
}
