{
  "manifest_version": 3,
  "name": "Claude Time Stamp",
  "version": "1.0.0",
  "description": "Appends your local time to every message you send on claude.ai.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Claude Time Stamp",
    "default_popup": "popup.html"
  }
}
